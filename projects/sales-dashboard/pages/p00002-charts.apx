page 2 (
    name: Charts
    alias: CHARTS
    title: Sales Charts
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region hero (
        name: Sales Charts
        title: Sales Charts
        type: staticContent
        layout {
            sequence: 5
            slot: breadcrumbBar
        }
        appearance {
            template: @/hero
            templateOptions: #DEFAULT#
        }
        image {
            fileUrl: #APP_FILES#icons/app-icon-512.png
        }
    )

    region revenue-share-pie (
        name: Revenue Share by Region
        type: chart
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        layout {
            sequence: 10
            slot: body
            columnSpan: 6
        }
        chart {
            type: pie
        }
        chartLayout {
            height: 380
        }
        series primary (
            name: Revenue Share by Region
            execution {
                sequence: 10
            }
            source {
                location: localDatabase
                type: sqlQuery
                sqlQuery: ```sql
                    SELECT region AS label, SUM(amount) AS value FROM sales GROUP BY region ORDER BY 2 DESC
                ```
            }
            columnMapping {
                label: LABEL
                value: VALUE
            }
        )
    )

    region transactions-donut (
        name: Transactions by Region
        type: chart
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        layout {
            sequence: 20
            slot: body
            startNewRow: false
            columnSpan: 6
        }
        chart {
            type: donut
        }
        chartLayout {
            height: 380
        }
        series primary (
            name: Transactions by Region
            execution {
                sequence: 10
            }
            source {
                location: localDatabase
                type: sqlQuery
                sqlQuery: ```sql
                    SELECT region AS label, COUNT(*) AS value FROM sales GROUP BY region ORDER BY 2 DESC
                ```
            }
            columnMapping {
                label: LABEL
                value: VALUE
            }
        )
    )

    region monthly-revenue-bar (
        name: Monthly Revenue
        type: chart
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        layout {
            sequence: 30
            slot: body
            columnSpan: 6
        }
        chart {
            type: bar
        }
        chartLayout {
            height: 380
        }
        series primary (
            name: Monthly Revenue
            execution {
                sequence: 10
            }
            source {
                location: localDatabase
                type: sqlQuery
                sqlQuery: ```sql
                    SELECT TO_CHAR(sale_date,'YYYY-MM') AS label, SUM(amount) AS value FROM sales GROUP BY TO_CHAR(sale_date,'YYYY-MM') ORDER BY 1
                ```
            }
            columnMapping {
                label: LABEL
                value: VALUE
            }
        )
        axis x (
            name: x
        )
        axis y (
            name: y
        )
    )

    region revenue-trend (
        name: Cumulative Revenue
        type: chart
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        layout {
            sequence: 40
            slot: body
            startNewRow: false
            columnSpan: 6
        }
        chart {
            type: lineWithArea
        }
        chartLayout {
            height: 380
        }
        series primary (
            name: Cumulative Revenue
            execution {
                sequence: 10
            }
            source {
                location: localDatabase
                type: sqlQuery
                sqlQuery: ```sql
                    SELECT m AS label, SUM(v) OVER (ORDER BY m) AS value FROM (SELECT TO_CHAR(sale_date,'YYYY-MM') AS m, SUM(amount) AS v FROM sales GROUP BY TO_CHAR(sale_date,'YYYY-MM')) ORDER BY m
                ```
            }
            columnMapping {
                label: LABEL
                value: VALUE
            }
        )
        axis x (
            name: x
        )
        axis y (
            name: y
        )
    )

    region avg-ticket-bar (
        name: Average Ticket by Region
        type: chart
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        layout {
            sequence: 50
            slot: body
            columnSpan: 12
        }
        chart {
            type: bar
        }
        chartLayout {
            height: 380
        }
        series primary (
            name: Average Ticket by Region
            execution {
                sequence: 10
            }
            source {
                location: localDatabase
                type: sqlQuery
                sqlQuery: ```sql
                    SELECT region AS label, ROUND(AVG(amount),2) AS value FROM sales GROUP BY region ORDER BY 2 DESC
                ```
            }
            columnMapping {
                label: LABEL
                value: VALUE
            }
        )
        axis x (
            name: x
        )
        axis y (
            name: y
        )
    )

)
