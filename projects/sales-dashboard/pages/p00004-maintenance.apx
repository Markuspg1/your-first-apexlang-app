page 4 (
    name: Maintenance
    alias: MAINTENANCE
    title: Maintenance
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region hero (
        name: Maintenance
        title: Maintenance
        type: staticContent
        layout {
            sequence: 5
            slot: breadcrumbBar
        }
        appearance {
            template: @/hero
            templateOptions: #DEFAULT#
        }
        image {
            fileUrl: #APP_FILES#icons/app-icon-512.png
        }
    )

    region sales-editor (
        name: Sales Data — Editable
        type: interactiveGrid
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        layout {
            sequence: 10
            slot: body
        }
        source {
            location: localDatabase
            type: tableView
            tableName: SALES
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        pagination {
            type: page
            showTotalCount: true
        }
        messages {
            whenNoDataFound: No sales rows yet.
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )
            displayColumn (
                column: @ID
                layout {
                    sequence: 1
                }
            )
            displayColumn (
                column: @REGION
                layout {
                    sequence: 2
                }
            )
            displayColumn (
                column: @AMOUNT
                layout {
                    sequence: 3
                }
            )
            displayColumn (
                column: @SALE_DATE
                layout {
                    sequence: 4
                }
            )
        )
        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )
        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )
        column ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ID
                dataType: number
                primaryKey: true
            }
        )
        column REGION (
            type: textField
            heading {
                heading: Region
            }
            layout {
                sequence: 40
            }
            validation {
                maxLength: 40
            }
            source {
                databaseColumn: REGION
                dataType: varchar2
            }
        )
        column AMOUNT (
            type: numberField
            heading {
                heading: Amount
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            appearance {
                formatMask: FML999G999G999G999G990D00
            }
            source {
                databaseColumn: AMOUNT
                dataType: number
            }
        )
        column SALE_DATE (
            type: datePicker
            heading {
                heading: Sale Date
            }
            layout {
                sequence: 60
            }
            appearance {
                formatMask: DD-MON-YYYY
            }
            source {
                databaseColumn: SALE_DATE
                dataType: date
            }
        )
    )

    process save-sales (
        name: Sales — Save Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @sales-editor
        execution {
            sequence: 10
        }
    )

    region schema-objects (
        name: Schema Objects
        type: interactiveReport
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        layout {
            sequence: 20
            slot: body
            columnSpan: 6
        }
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery: ```sql
                SELECT object_name, object_type, status, created, last_ddl_time FROM user_objects ORDER BY object_type, object_name
            ```
        }
        column OBJECT_NAME (
            type: plainText
            heading {
                heading: "Object"
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
        )
        column OBJECT_TYPE (
            type: plainText
            heading {
                heading: "Type"
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
        )
        column STATUS (
            type: plainText
            heading {
                heading: "Status"
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )
        column CREATED (
            type: plainText
            heading {
                heading: "Created"
            }
            layout {
                sequence: 40
            }
            appearance {
                formatMask: DD-MON-YYYY HH24:MI
            }
            source {
                dataType: DATE
            }
        )
        column LAST_DDL_TIME (
            type: plainText
            heading {
                heading: "Last DDL"
            }
            layout {
                sequence: 50
            }
            appearance {
                formatMask: DD-MON-YYYY HH24:MI
            }
            source {
                dataType: DATE
            }
        )
    )

    region data-health (
        name: Data Health
        type: interactiveReport
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        layout {
            sequence: 30
            slot: body
            startNewRow: false
            columnSpan: 6
        }
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery: ```sql
                SELECT 'Rows in SALES' AS metric, TO_CHAR(COUNT(*)) AS value FROM sales UNION ALL SELECT 'Distinct regions', TO_CHAR(COUNT(DISTINCT region)) FROM sales UNION ALL SELECT 'Earliest sale', TO_CHAR(MIN(sale_date),'YYYY-MM-DD') FROM sales UNION ALL SELECT 'Latest sale', TO_CHAR(MAX(sale_date),'YYYY-MM-DD') FROM sales UNION ALL SELECT 'Total revenue', TO_CHAR(SUM(amount),'FM999G999G990D00') FROM sales UNION ALL SELECT 'Rows with NULL amount', TO_CHAR(COUNT(*)) FROM sales WHERE amount IS NULL
            ```
        }
        column METRIC (
            type: plainText
            heading {
                heading: "Check"
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
        )
        column VALUE (
            type: plainText
            heading {
                heading: "Value"
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
        )
    )
)
